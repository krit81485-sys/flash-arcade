<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0D">

    <WebView
        android:id="@+id/game_web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080A0D"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <com.flasharcade.launcher.ui.TouchPassthroughFrameLayout
        android:id="@+id/controls_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/exit_button"
            android:layout_width="52dp"
            android:layout_height="38dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/game_control_button"
            android:gravity="center"
            android:text="EXIT"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/diagnostics_button"
            android:layout_width="78dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/game_control_button"
            android:gravity="center"
            android:text="LOGS"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/control_up"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="112dp"
            android:layout_marginBottom="122dp"
            android:background="@drawable/game_control_button"
            android:contentDescription="Up directional key"
            android:gravity="center"
            android:text="↑"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/control_down"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="112dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/game_control_button"
            android:contentDescription="Down directional key"
            android:gravity="center"
            android:text="↓"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/control_left"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="77dp"
            android:background="@drawable/game_control_button"
            android:contentDescription="Left directional key"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/control_right"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="184dp"
            android:layout_marginBottom="77dp"
            android:background="@drawable/game_control_button"
            android:contentDescription="Right directional key"
            android:gravity="center"
            android:text="→"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/action_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/game_control_button"
            android:contentDescription="Action (Spacebar)"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />
    </com.flasharcade.launcher.ui.TouchPassthroughFrameLayout>

    <LinearLayout
        android:id="@+id/player_diagnostics_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#F012171D"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PLAYER DIAGNOSTICS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diagnostics_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/game_control_button"
                android:contentDescription="Close diagnostics"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="25sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="Recent Ruffle warnings/errors and resource-load issues. Reports omit query strings and device details."
            android:textColor="#C5D0D9"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/diagnostics_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#CC080A0D"
            android:fillViewport="true"
            android:padding="10dp">

            <TextView
                android:id="@+id/diagnostics_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No player issues captured yet."
                android:textColor="#F2F5F7"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:typeface="monospace" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/diagnostics_copy"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/game_control_button"
                android:contentDescription="Copy diagnostics report"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="COPY"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/diagnostics_share"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/game_control_button"
                android:contentDescription="Share diagnostics report"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="SHARE"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/player_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC080A0D"
        android:clickable="false"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
